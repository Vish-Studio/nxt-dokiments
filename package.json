{
  "name": "nxt-dokiments",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "capture:marketing": "node scripts/capture-marketing-screens.mjs",
    "seed:templates": "tsc -p tsconfig.seed.json && node --env-file=.env.local .scratch-seed/scripts/seed-templates.js",
    "backfill:template-created-at": "tsc -p tsconfig.seed.json && node --env-file=.env.local .scratch-seed/scripts/backfill-template-created-at.js",
    "test:rules": "npx firebase-tools@15 emulators:exec --only firestore --project demo-dokiments-rules \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "npx firebase-tools@15 emulators:start --only auth,firestore --project demo-dokiments --import .emulator-data --export-on-exit",
    "dev:emulated": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_PROJECT_ID=demo-dokiments FIREBASE_API_KEY=emulator next dev",
    "emulators:seed": "tsc -p tsconfig.seed.json && FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_PROJECT_ID=demo-dokiments FIREBASE_API_KEY=emulator SEED_ADMIN_EMAIL=admin@dokiments.local SEED_ADMIN_PASSWORD=localadmin123 sh -c 'node .scratch-seed/scripts/seed-emulator-admin.js && node .scratch-seed/scripts/seed-templates.js'",
    "push:keys": "web-push generate-vapid-keys",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "start:phone": "node scripts/start-phone.mjs",
    "pre-pr-check": "npm run lint && npm run build && npx vitest run"
  },
  "dependencies": {
    "@altalyst/hookify": "0.13.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@serwist/turbopack": "^9.5.12",
    "@tanstack/react-query": "^5.101.4",
    "daisyui": "^5.7.50",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.15.0",
    "html-to-image": "^1.11.13",
    "iron-session": "^8.0.4",
    "jspdf": "^4.2.1",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.79.0",
    "resend": "^6.35.0",
    "serwist": "^9.5.12",
    "web-push": "^4.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-mcp": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/nextjs-vite": "^10.6.5",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "cloudflared": "^0.7.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-storybook": "^10.6.0",
    "playwright": "^1.61.0",
    "storybook": "^10.6.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.16",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "browserslist": "4.28.9",
    "@grpc/grpc-js": "^1.14.5",
    "zod": "$zod",
    "html-to-text": "^10.0.1",
    "minimatch": "^11.0.3",
    "glob": "^14.0.3"
  }
}
