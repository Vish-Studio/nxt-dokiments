# Firebase — server-only (no NEXT_PUBLIC_ prefix)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Session encryption secret
# Generated with: openssl rand -base64 32
SESSION_SECRET=your-session-secret

# Google OAuth ("Sign in with Google") — server-only (no NEXT_PUBLIC_ prefix)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Dev auth bypass — server-only (no NEXT_PUBLIC_ prefix)
# Set to "true" in development to skip real Firebase auth
DEV_AUTH_BYPASS=false

# Temporary public-launch switch — lifts all marketplace tier locks and save
# limits for every user. NEXT_PUBLIC_ vars are inlined into the JS bundle at
# build time, so toggling this requires a rebuild + redeploy to take effect —
# it is not a live runtime switch. Remove/unset once tiers are ready to be
# enforced, then rebuild.
NEXT_PUBLIC_DISABLE_TIER_LOCKS=false

# Public site URL — used for absolute metadata URLs (OpenGraph, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://nxt-dokiments.vercel.app

# Google Analytics 4 measurement ID. Leave unset to disable analytics entirely
# (the GA script tags are only injected when this is present).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity project ID. Leave unset to disable Clarity entirely.
# Clarity is loaded only after a visitor accepts optional analytics cookies.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
