{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".scratch-seed",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "types": ["node"]
  },
  "include": [
    "scripts/seed-templates.ts",
    "src/lib/market-place/documents.ts",
    "src/lib/market-place/styles.ts",
    "src/types/template.ts",
    "src/types/auth.ts"
  ]
}
